--label:光効果
--group:バックライト設定
--track@light_x:光源位置X,-2000,2000,0.0,0.1;
--track@light_y:光源位置Y,-2000,2000,0.0,0.1;
--track@light_size:光源サイズ,0,5000,1000,0.1;
--track@light_xy:光源縦横比, -1.00, 1.00, 0, 0.01;
--track@radius_light:光源の丸さ,0,1000,0,0.01;
--track@light_bloom:光源の遠さ,0,1500,1.0,0.01;
--track@light_scater:光の拡散,0,10,5.0, 0.01;
--group:境界ノーマル取得手法
--track@mask:マスクの濃さ,0.0, 1.0, 0.0, 0.01;
--track@seed:シード値,0.0, 100, 0.0, 0.01;
--track@noise:ノイズの導入, 0.0, 100, 0.0, 0.01;
--group:デバッグ用設定
--track@length:サンプル距離,0.0, 1000.0, 100.0, 0.01;
--select@preView:プレビュー,撮影=0, 光のノーマルと位置描画=1, 境界プレビュー=2, 光の角度固定=3
--track@lightDir:角度固定時の光角度, -360.0, 360.0, 0, 0.01;
--group:撮影用設定
--track@strength:光の強さ,0.0, 100.0, 0.0, 0.01;
--track@blur:リム/回り込み比,-100.0, 100.0, 0.0, 0.01;
--track@limStr:リムライトの幅,0.0, 100.0, 0.0, 0.01;
--track@blurleng:回り込み幅,0.0, 200.0, 100.0, 0.01;
--color@col:色,0xffffff;
--track@hueShift:色相_時間制御用,-360,360,0,0.1
--track@saturateShift:彩度_時間制御用,-100,100,0,0.1
--光源の丸さによってぼかし処理を入れる　一定以上の大きさの時は縮小してからぼかして再拡大
--境界ノーマル取得手法のcheck@censeNoise:ノイズを無くす,false;がなぜかエラーを起こす　この機にブラーの半径を導入するとするか

--[[pixelshader@SDF_light:
    Texture2D tempbuffer : register(t0);
    SamplerState sampler0 : register(s0);
    cbuffer constant0 : register(b0){
        float light_size;   // half size in pixels
        float light_x;      // offset from center (px)
        float light_y;
        float light_xy;     // aspect -1..1
        float radius_light; // corner radius (px)
        float light_bloom;  //光の広がり_被写体から光源までの距離を想定
    }

    float4 SDF_light(float4 pos : SV_Position) : SV_Target {
    //今後ここの傾きの行き来が急なのを改善しなければいけない
        uint w, h;
        tempbuffer.GetDimensions(w, h);

        // everything in pixel space
        float2 center = float2(w, h) * 0.5 + float2(light_x, light_y);
        float2 p = pos.xy - center;

        const float Z0 = 200;       //被写体とカメラの距離を想定
        float light_lookSize = light_size * Z0 / (Z0 + light_bloom);

        float2 halfSize = light_lookSize * float2(
            clamp(1.0 + light_xy, 0.01, 1.0),
            clamp(1.0 - light_xy, 0.01, 1.0));

        // radius must not exceed half size
        float r = clamp(radius_light, 0.0, min(halfSize.x, halfSize.y));

        // rounded box SDF
        float2 q = abs(p) - halfSize + r;   //ここで図形の大元からの距離とベクトルが決まる
        float d = min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - r;    //ここで図形からの距離が決まる

        //外側の方向(内側は sinΘ = 0で消えるのでなんでもいい)
        float2 s = float2(p.x < 0 ? -1.0 : 1.0, p.y < 0 ? -1.0 : 1.0);
        float2 g = (max(q.x, q.y) > 0.0)
            ? normalize(max(q, 0.0))
            : ((q.x > q.y) ? float2(1, 0) : float2(0, 1));
        g *= s;

        // 高さ b の光源として仰角を求める
        float dOut = max(d, 0.0);
        float b    = max(light_bloom, 1e-5);
        float invL = rsqrt(dOut * dOut + b * b);        //角度　直角三角形の斜めの辺で1を割ってるような値
        float sinT = dOut * invL;      // 水平成分 → 傾きの大きさ
        float cosT = b * invL;         // 鉛直成分
        float sloop = cosT * cosT;     // = 1/(1+(d/b)^2)
        float damp = 1 / (1+(light_bloom/1000)*(light_bloom/1000));
        return float4(g * sinT * 0.5 + 0.5, sloop * damp, 1);
    }
]]

--コーシーブラー
--[[pixelshader@CauchyBlur:
    Texture2D tempbuffer : register(t0);
    SamplerState sampler0 : register(s0);
    cbuffer constant0 : register(b0){
        float radius;
        float angle;
    };
    float4 CauchyBlur(float4 pos : SV_Position): SV_Target{
        uint w,h;
        tempbuffer.GetDimensions(w,h);
        float2 texelSize = float2(1.0/w, 1.0/h);
        float2 uv = pos.xy * texelSize;

        float4 result =  float4(0,0,0,0);

        int samples = (int)(radius * 6.0);
        samples = clamp(samples, (int)32, (int)256);
        float pi = 3.1415926;
        float rad = angle / 180 * pi;

        float totalW = 0.0;
        if(radius < 1e-4)return tempbuffer.Sample(sampler0, uv);
        for(int i = (-1 * samples); i <= samples; i++){
            float2 offset = float2(
                i * texelSize.x * cos(rad), 
                i * sin(rad) * texelSize.y
                );
            float2 sampleUV = uv + offset;
            float inside = (all(sampleUV >= 0.0) && all(sampleUV <= 1.0)) ? 1.0 : 0.0;
            float dist = abs(float(i))/radius;
            float weight = 1.0 / (dist * dist + 1.0);
            result += tempbuffer.Sample(sampler0, sampleUV) * weight * inside;
            totalW += weight * inside;
        }
        result /= totalW;
        return result;

    }
]]

--空白部分を検知してそこの方角で加算　最終的にどの方角がどれほど空いてるかを数値化する
--[[pixelshader@EmptyLight:
    Texture2D originbuffer : register(t0);
    SamplerState sampler0 : register(s0);
    cbuffer constant0 : register(b0){
        float mask;
        float seed;
        float lightLen;
    };
    float linearstep(float edge0, float edge1, float x){
        return min(max(((x) - (edge0)) / ((edge1) - (edge0)), 0.0), 1.0);
    }
    
    float4 EmptyLight(float4 input : SV_Position): SV_Target{
        uint w,h;
        originbuffer.GetDimensions(w,h);
        float2 texelSize = float2(1.0/w, 1.0/h);

        float2 uv = input.xy * texelSize;
        float4 origin = originbuffer.Sample(sampler0, uv);

        const int N = 96;
        const float GA = 2.39996323;
        float ign = frac(52.9829189 * frac(dot(input.xy + seed * 131.0, float2(0.06711056, 0.00583715))));
        float ang0 = ign * 6.28318531;

        float4 sumDir = 0;
        float4 sumWeight = 0;  //範囲外を除外するためと最大値を1にするために重みの合計値が必要

        [loop] for (int i = 0; i < N; i++){
            float fi = (i + 0.5) / N;
            float rr = fi;                 //距離比 面積に対して均一にする、面積は半径の2乗で増えるのに対して半径をsqrtで狭める
            float a  = i * GA + ang0;
            float2 dir = float2(cos(a), sin(a));    //この角度を取っておく
            float2 suv = uv + dir * rr * texelSize * lightLen;  //ディスクの一点に観測点を置く

            float onScreen = (all(suv >= 0.0) && all(suv <= 1.0)) ? 1.0 : 0.0;  //範囲外を除外
            float sa =(1 - originbuffer.Sample(sampler0, suv).a) * onScreen;   //アルファ値取得
            sa = linearstep(mask, mask+0.01, sa);       //マスク判定　もしもマスクを滑らかにするならここの閾値を工夫すればいい
            if(dir.x > 0){
                sumDir.x += sa * dir.x;
                sumWeight.x += dir.x * onScreen;
            }
            else{
                sumDir.z -= sa * dir.x;
                sumWeight.z -= dir.x * onScreen;
            }
            if(dir.y > 0){
                sumDir.y += sa * dir.y;
                sumWeight.y += dir.y * onScreen; 
            }
            else{
                sumDir.a -= sa * dir.y;
                sumWeight.a -= dir.y * onScreen;
            }
        }
        float4 totalDir = sumDir / max(sumWeight, 1e-5);
        //決めた　チャンネルのxyを正の方向のベクトルから受けた光　zaを負の方向から受けた光にして出力する　あとは方角に応じた光の応答を示すシェーダーを作る
        return totalDir * origin.a;
    }
]]

--EmptyLightのノイズをキャンセルする
--[[pixelshader@BlurPlAlpha:
    Texture2D tempbuffer : register(t0);
    Texture2D originbuffer : register(t1);
    SamplerState sampler0 : register(s0);
        cbuffer constant0 : register(b0){
        float detail;
    };
    float4 BlurPlAlpha(float4 input : SV_Position): SV_Target{
        uint w,h;
        tempbuffer.GetDimensions(w,h);
        float2 texelSize = float2(1.0/w, 1.0/h);
        float2 uv = input.xy * texelSize;

        const float radius = 10.0;

        float sigma_space = float(radius) / 3.0;
        float sigma_color = (1.0 - detail / 100.0) * 0.3 + 0.01;
        float rx = radius;
        float ry = radius;

        float4 color = float4(0,0,0,0);
        float totalWeight = 0.0;
        float4 center = tempbuffer.Sample(sampler0, uv);
        float original = originbuffer.Sample(sampler0, uv).a;
        //if(center.a < 1e-4){return center;}       //よく考えたらaも使っているので当てにならない

        for(int x = -rx; x <= rx; x++){
            for(int y = -ry; y <= ry; y++){
                float2 sampleUV = uv + float2(x * texelSize.x, y * texelSize.y);
                float4 sampleColor = tempbuffer.Sample(sampler0, sampleUV);
                float sampleOrig = originbuffer.Sample(sampler0, sampleUV).a;
                float spatialWeight = exp(-(x * x + y * y) / (2.0 * sigma_space * sigma_space));
                float colorDiff = length(sampleColor.rgb - center.rgb);
                float colorWeight = exp(-(colorDiff * colorDiff) / (2.0 * sigma_color * sigma_color));
                
                float weight = spatialWeight * colorWeight * sampleOrig;
                color += sampleColor * weight;
                totalWeight += weight;
            }
        }
        if(original < 1e-4){return center;}
        float4 bilateral_result = color / totalWeight;
        return bilateral_result;
    }
]]
--各角度の空白からどれぐらい光を浴びるか計算する　角度を固定とする
--[[pixelshader@LightDir:
    Texture2D originbuffer : register(t0);
    Texture2D empdirbuffer : register(t1);
    SamplerState sampler0 : register(s0);
    cbuffer constant0 : register(b0){
        float lightLen;
        float lightDir;
    };
    float linearstep(float edge0, float edge1, float x){
        return min(max(((x) - (edge0)) / ((edge1) - (edge0)), 0.0), 1.0);
    }
    float4 LightDir(float4 input : SV_Position): SV_Target{
        uint w,h;
        originbuffer.GetDimensions(w,h);
        float2 texelSize = float2(1.0/w, 1.0/h);
        float2 uv = input.xy * texelSize;
        float4 original = originbuffer.Sample(sampler0, uv);
        float4 empdir = empdirbuffer.Sample(sampler0, uv);
        float2 lightStr = 0;
        if(cos(lightDir) > 0){
            lightStr.x = cos(lightDir) * empdir.x;
        }
        else {
            lightStr.x = cos(lightDir) * empdir.z;

        }
        if(sin(lightDir) > 0){
            lightStr.y = sin(lightDir) * empdir.y;
        }
        else{
            lightStr.y = sin(lightDir) * empdir.a;
        }
        float result = lightStr.x * lightStr.x + lightStr.y * lightStr.y;
        float3 color = result * original.a;
        return float4(color, original.a);//出力用 仮
    }
]]

--角度と光の強さ、そして距離で合成　いよいよ合成
--[[pixelshader@PSMain:
    Texture2D Origin : register(t0);
    Texture2D lightMap : register(t1);
    Texture2D limMask : register(t2);
    Texture2D blurMask : register(t3);
    SamplerState sampler0 : register(s0);
    cbuffer constant0 : register(b0){
        float strength;        //光の強さ
        float light_bloom;     //光の指向性
    };
    float linearstep(float edge0, float edge1, float x){
        return min(max(((x) - (edge0)) / ((edge1) - (edge0)), 0.0), 1.0);
    }
    float DirectionFilter(float2 grad, float angle, float useAngle)
    {
        float rad = radians(angle);
        float2 dir = float2(cos(rad), sin(rad));
        float d = (1 + dot(normalize(grad + 0.0001),dir))/2;
        return lerp(1.0, d, useAngle); //同じ方向で1　直角で0.5　真逆で0
    }
    float4 PSMain(float4 input : SV_Position): SV_Target{
            uint w,h;
        Origin.GetDimensions(w,h);
        float2 texelSize = float2(1.0/w, 1.0/h);

        float2 uv = input.xy * texelSize;
        float4 origin = Origin.Sample(sampler0, uv);
        float4 color = float4(0,0,0,0);

        return float4(1,0,1,1);


        /*
        // 3x3近傍のαを取得：：光マップ
        float a00 = lightMap.Sample(sampler0, uv + float2(-1,-1) * texelSize).a;
        float a10 = lightMap.Sample(sampler0, uv + float2( 0,-1) * texelSize).a;
        float a20 = lightMap.Sample(sampler0, uv + float2( 1,-1) * texelSize).a;
        float a01 = lightMap.Sample(sampler0, uv + float2(-1, 0) * texelSize).a;
        float a21 = lightMap.Sample(sampler0, uv + float2( 1, 0) * texelSize).a;
        float a02 = lightMap.Sample(sampler0, uv + float2(-1, 1) * texelSize).a;
        float a12 = lightMap.Sample(sampler0, uv + float2( 0, 1) * texelSize).a;
        float a22 = lightMap.Sample(sampler0, uv + float2( 1, 1) * texelSize).a;

        // Sobel勾配計算
        float gx = -a00 - 2*a01 - a02 + a20 + 2*a21 + a22;
        float gy = -a00 - 2*a10 - a20 + a02 + 2*a12 + a22;
        float gradient = sqrt(gx*gx + gy*gy) / sqrt(32);
        float3 Lnorm = normalize(float3(gx, gy, 1-light_bloom+0.01));

        // 3x3近傍のαを取得：：アルファマップ
        a00 = alphaMask.Sample(sampler0, uv + float2(-1,-1) * texelSize).r;
        a10 = alphaMask.Sample(sampler0, uv + float2( 0,-1) * texelSize).r;
        a20 = alphaMask.Sample(sampler0, uv + float2( 1,-1) * texelSize).r;
        a01 = alphaMask.Sample(sampler0, uv + float2(-1, 0) * texelSize).r;
        a21 = alphaMask.Sample(sampler0, uv + float2( 1, 0) * texelSize).r;
        a02 = alphaMask.Sample(sampler0, uv + float2(-1, 1) * texelSize).r;
        a12 = alphaMask.Sample(sampler0, uv + float2( 0, 1) * texelSize).r;
        a22 = alphaMask.Sample(sampler0, uv + float2( 1, 1) * texelSize).r;

        // Sobel勾配計算
        float Mgx = -a00 - 2*a01 - a02 + a20 + 2*a21 + a22;
        float Mgy = -a00 - 2*a10 - a20 + a02 + 2*a12 + a22;
        float3 Mnorm = float3(normalize(float2(Mgx, Mgy)), 0);

        
        //float3 n = normalize(float3(-gx, -gy, 1-light_bloom+0.01));
        //float3 NormalColor = (n * 0.5 + 0.5)*a00;
        
        //とりあえず光の方向と境界のベクトルが噛み合っているかを測ろう
        float StrNorm = dot(Mnorm, Lnorm);//裾野が長い光ほどこれの影響が強くなる なぜか逆転することになった　なんでだろう
        //多分割り算だけだと裾野の広さが残ってしまってダメなのでmin0で引き算することになる
        StrNorm = 0.5 + StrNorm * 0.5;
        //それぞれの光の強さを測る
        float StrAlp = alphaMask.Sample(sampler0, uv).a;
        float StrLht = lightMap.Sample(sampler0, uv).a;
        //StrNormに本当に傾きが無い時の扱いなどに難あり　nを何かしらの手法を使って使った方がいいかも
        //目下の問題は法線の扱い　光の法線とアルファマップのぼかしの法線に合う場合は強く、そうでない時(線の法線が下(下にマスク面有)で光の法線が真上)は弱くしなければいけない
        //真正面の法線は真正面とする　…とりあえずアルファマップのぼかしの法線は二次元でz成分を0固定として扱うぐらいで良さそう
        //あとはぼかしを下げると法線の影響が下がるような操作性にしたい
        float Backlit = StrAlp* StrLht* StrNorm *origin.a * strength;
        return float4(Backlit, Backlit, Backlit, origin.a);
        */
        
    }
]]

local function CauchyBlurAll(radius)
    obj.pixelshader("CauchyBlur","object",{"object"},{radius, 0})
    obj.pixelshader("CauchyBlur","object",{"object"},{radius, 45})
    obj.pixelshader("CauchyBlur","object",{"object"},{radius, -45})
    obj.pixelshader("CauchyBlur","object",{"object"},{radius, 90})
end

obj.copybuffer("cache:original","object")
obj.pixelshader("SDF_light","object",{"object"},{light_size, light_x, light_y, light_xy, radius_light, light_bloom},"copy","clip")
CauchyBlurAll(light_scater * light_bloom / 20)
--ここで値が整数固定になってしまうので
obj.copybuffer("cache:light","object")
if preView == 1 then
    
elseif preView == 2 then 
    obj.pixelshader("EmptyLight","object",{"cache:original"},{mask, seed, length},"copy","mirror")
    obj.pixelshader("BlurPlAlpha","object",{"object", "cache:original"},{noise},"copy", "clip")
else
    obj.pixelshader("EmptyLight","object",{"cache:original"},{mask, seed, length},"copy","mirror")
    obj.pixelshader("BlurPlAlpha","object",{"object", "cache:original"},{noise},"copy", "clip")
    obj.copybuffer("cache:AlphaMap", "object")
    obj.pixelshader("LightDir","object",{"cache:original", "cache:AlphaMap"},{length, lightDir / 180 * math.pi},"copy","clip")
end

if preView == 0 then
    obj.pixelshader("EmptyLight","object",{"cache:original"},{mask, seed, limStr},"copy","mirror")
    obj.pixelshader("BlurPlAlpha","object",{"object", "cache:original"},{noise},"copy", "clip")
    obj.copybuffer("cache:limMap", "object")
    --この辺りで回り込みの広さ、blurlengthを求める式を入れる　あとでこれで実際に動かして塩梅を探りたい
    --blurlength:0~100~1000 light_size:0~5000(半径)
    local Z0 = 200;       --被写体とカメラの距離を想定
    local light_lookSize = light_size * Z0 / (Z0 + light_bloom);
    local halfSizeX = light_lookSize * math.min(math.max(1.0 + light_xy, 0.01), 1.0);
    local halfSizeY = light_lookSize * math.min(math.max(1.0 - light_xy, 0.01), 1.0);
    local r = math.max(0.0, math.min(radius_light, math.min(halfSizeX, halfSizeY)))
    local area = 4.0 * halfSizeX * halfSizeY - (4.0 - math.pi)* r * r
    local s_eff = math.sqrt(max(area, 1e-3));
    local sigma_warp = blurleng / 100 * s_eff / max(light_dist, 1e-5)   --回り込みの広さ
    obj.pixelshader("EmptyLight","object",{"cache:original"},{mask, seed, sigma_warp},"copy","mirror")
    obj.pixelshader("BlurPlAlpha","object",{"object", "cache:original"},{noise},"copy", "clip")
    obj.copybuffer("cache:blurMap", "object")
    obj.pixelshader("PSMain","object",{"cache:original","cache:light","cache:limMap","cache:blurMap"},{strength, blur, limStr, blurlength},"copy","loop")
end


